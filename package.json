{
  "name": "jsonrocks",
  "version": "0.0.67",
  "description": "turn any page into json",
  "license": "AGPL-3.0-or-later",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "mocha test/**/*.test.js --timeout 10000",
    "test:watch": "mocha test/**/*.test.js --watch",
    "test:coverage": "c8 mocha test/**/*.test.js --timeout 10000",
    "test:security": "mocha test/security/*.test.js --timeout 10000",
    "test:api": "mocha test/api/*.test.js --timeout 10000",
    "test:integration": "mocha test/integration/*.test.js --timeout 10000",
    "test:performance": "mocha test/performance/*.test.js --timeout 120000",
    "test:performance:rate": "mocha test/performance/rate-limit.test.js --timeout 120000",
    "test:performance:cache": "mocha test/performance/cache.test.js --timeout 60000",
    "test:performance:concurrency": "mocha test/performance/concurrency.test.js --timeout 60000",
    "test:performance:response": "mocha test/performance/response-time.test.js --timeout 60000",
    "test:load:artillery": "artillery run test/performance/artillery-load-test.yml",
    "test:load:k6": "k6 run test/performance/k6-load-test.js",
    "benchmark": "npm run test:performance"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spux/json.rocks.git"
  },
  "keywords": [
    "json"
  ],
  "author": "Melvin Carvalho",
  "bugs": {
    "url": "https://github.com/spux/json.rocks/issues"
  },
  "homepage": "https://github.com/spux/json.rocks#readme",
  "dependencies": {
    "@fastify/basic-auth": "^3.0.2",
    "axios": "^1.13.2",
    "cheerio": "^1.0.0-rc.3",
    "fastify": "^3.4.1",
    "fastify-compress": "^3.7.0",
    "fastify-cors": "^6.0.3",
    "fastify-rate-limit": "^5.8.0",
    "fs-extra": "^9.0.1",
    "lru-cache": "^11.1.0",
    "metascraper": "^5.14.14",
    "metascraper-amazon": "^5.14.14",
    "metascraper-audio": "^5.14.14",
    "metascraper-author": "^5.14.14",
    "metascraper-clearbit": "^5.14.14",
    "metascraper-date": "^5.14.14",
    "metascraper-description": "^5.14.14",
    "metascraper-image": "^5.14.14",
    "metascraper-lang": "^5.14.14",
    "metascraper-logo": "^5.14.14",
    "metascraper-logo-favicon": "^5.14.14",
    "metascraper-publisher": "^5.14.14",
    "metascraper-readability": "^5.14.14",
    "metascraper-spotify": "^5.14.14",
    "metascraper-title": "^5.14.14",
    "metascraper-url": "^5.14.14",
    "metascraper-video": "^5.14.14",
    "metascraper-youtube": "^5.14.14",
    "minimist": "^1.2.5",
    "mkdirp": "^1.0.4",
    "path": "^0.12.7",
    "scrapex": "^0.3.4",
    "unfluff": "^3.2.0"
  },
  "devDependencies": {
    "c8": "^10.1.2",
    "chai": "^5.1.2",
    "mocha": "^10.8.2"
  }
}
