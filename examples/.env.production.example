# Production environment variables for json.rocks
#
# Copy this file to .env.production and update the values
# IMPORTANT: Never commit .env.production to version control!
#
# Usage:
#   cp .env.production.example .env.production
#   # Edit .env.production with your values
#   docker-compose -f docker-compose.production.yml --env-file .env.production up -d
#
# See: docs/ENVIRONMENT_VARIABLES.md

# Node.js environment
NODE_ENV=production

# Admin credentials
# REQUIRED: Set a strong random password
# Generate with: openssl rand -base64 32
ADMIN_USER=admin
ADMIN_PASS=CHANGE_THIS_TO_A_SECURE_PASSWORD

# API Authentication mode
# Options: open, optional, required
# - open: No authentication required (default)
# - optional: Authenticated requests get higher rate limits
# - required: All requests must include valid API key
AUTH_MODE=optional

# Server configuration
# PORT=9980  # Optional: Override default port

# Future environment variables (not yet implemented)
# LOG_LEVEL=info
# LOG_FORMAT=json
# CACHE_MEMORY_MAX_ITEMS=100
# CACHE_MEMORY_TTL_SECONDS=1800
# MAX_CONTENT_SIZE_MB=5
# MAX_CONCURRENT_REQUESTS_PER_IP=5
